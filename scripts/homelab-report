#!/bin/bash
# Sends a startup summary to n8n once the apps are up.
APPS="Jellyfin=http://localhost:8096/health Seanime=http://localhost:43211 AdGuard=http://localhost:80 Portainer=https://localhost:9443 UptimeKuma=http://localhost:3001 Homepage=http://localhost:3002 Beszel=http://localhost:8090"

# Give the apps up to 3 minutes to start
for i in $(seq 1 18); do
  curl -sk -o /dev/null --max-time 3 http://localhost:5678/healthz && break
  sleep 10
done
sleep 30

UP=0; TOTAL=0; DOWN=""
for app in $APPS; do
  TOTAL=$((TOTAL + 1))
  if curl -sk -o /dev/null --max-time 5 "${app#*=}"; then
    UP=$((UP + 1))
  else
    DOWN="$DOWN ${app%%=*}"
  fi
done

DISK=$(df -h / | awk 'NR==2 {print $4}')
SENSOR=$(grep -l "Package id 0" /sys/class/hwmon/hwmon*/temp*_label 2>/dev/null | head -1)
TEMP=$(( $(cat "${SENSOR%_label}_input" 2>/dev/null || echo 0) / 1000 ))
IP=$(ip -4 -br addr show wlo1 | awk '{print $3}' | cut -d/ -f1)

curl -s -X POST http://localhost:5678/webhook/server-started \
  -H "Content-Type: application/json" \
  -d "{\"apps_up\":$UP,\"apps_total\":$TOTAL,\"down\":\"${DOWN# }\",\"disk_free\":\"$DISK\",\"temp\":$TEMP,\"ip\":\"$IP\"}"
