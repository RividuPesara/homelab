    {
      "parameters": {
        "jsCode": "const log = $('Query log').first().json.data || [];\nconst list = $('HaGeZi Ultimate').first().json.data || '';\nconst userRules = $('Current rules').first().json.user_rules || [];\n\nconst already = new Set();\nfor (const r of userRules) {\n  const m = r.match(/^(@@)?\\|\\|([^\\^]+)\\^/);\n  if (m) already.add(m[2].toLowerCase());\n}\n\nconst ultimate = new Set();\nfor (const line of list.split('\\n')) {\n  const m = line.match(/^\\|\\|([^\\^]+)\\^/);\n  if (m) ultimate.add(m[1]);\n}\nconst inUltimate = d => {\n  const p = d.split('.');\n  for (let i = 0; i < p.length - 1; i++) if (ultimate.has(p.slice(i).join('.'))) return true;\n  return false;\n};\n\nconst looksLikeAds = /(^|[.-])(ads?|adserv|track(er|ing)?|pixel|analytics|telemetry|metrics|beacon)([.-]|\\d|$)/i;\nconst skip = /(\\.ts\\.net|\\.internal|\\.local|\\.arpa|localhost)$/i;\nconst neverSuggest = /(^|\\.)(graph\\.facebook\\.com|history\\.google\\.com|whatsapp\\.(com|net)|googleapis\\.com|gstatic\\.com)$/i;\n\nconst since = Date.now() - 24 * 60 * 60 * 1000;\n\nconst found = new Map();\nfor (const e of log) {\n  if (new Date(e.time).getTime() < since) continue;\n  const d = (e.question?.name || '').toLowerCase().replace(/\\.$/, '');\n  if (!d || skip.test(d) || neverSuggest.test(d) || already.has(d) || found.has(d)) continue;\n  if (inUltimate(d)) found.set(d, 'HaGeZi Ultimate');\n  else if (looksLikeAds.test(d)) found.set(d, 'looks like ads');\n}\n\nconst domains = [...found.entries()].slice(0, 25).map(([domain, why]) => ({ domain, why }));\nreturn [{ json: {\n  count: domains.length,\n  domains,\n  list: domains.map(x => `\u2022 ${x.domain} (${x.why})`).join('\\n')\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
