        "jsCode": "const current = $('Get rules').first().json.user_rules || [];\nconst domains = $('Find ad domains').first().json.domains;\n\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Colombo' });\n\nconst newRules = domains.map(x => `||${x.domain}^`).filter(r => !current.includes(r));\nconst rules = newRules.length ? [...current, `! added by n8n ${today}`, ...newRules] : current;\n\nreturn [{ json: { rules, added: newRules.length } }];"
      },
